<html>
  <head>
    <title>{{ title }} </title>
    <style lang="css">
      :root{
        --bg: #fafafa;
        --bg-alt: #ffffff;
        --foreground: #2a2a2a;
        --muted: #777;
        --border: #e5e5e5;

        --blue: #4a90e2;
        --green: #6fcf97;
        --orange: #f2a85d;
        --pink: #d86ca8;
        --purple: #9b6ef3;
        --red: #e85a5a;
      }

      html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--foreground);
        font-family: Inter, "Helvetica Neue", Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      ::selection {
        background: #e0d4ff;
        color: var(--foreground);
      }

      .container {
        max-width: 1000px;
        margin: 2.5rem auto;
        padding: 2rem;
        background: var(--bg-alt);
        border-radius: 14px;
        border: 1px solid var(--border);
        box-shadow: 0 3px 14px rgba(0,0,0,0.06);
      }

      h1, h2, h3, h4 {
        margin: 0 0 0.6rem 0;
        font-weight: 600;
      }
      h1 { font-size: 2rem; }
      h2 { color: var(--purple); }

      p {
        line-height: 1.6;
        color: var(--foreground);
      }
      small { color: var(--muted); }

      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb {
        background: #dcdcdc;
        border-radius: 10px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>{{ subject }}</h1>
      <p>
        {{ message }}
      </p>
      <p>
       📌 Has stick? {{ stickyCookie }}
      </p>
    </div>
  </body>
</html>